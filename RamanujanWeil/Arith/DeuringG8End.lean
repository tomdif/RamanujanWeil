import RamanujanWeil.Arith.DeuringG7Dual2
import RamanujanWeil.Arith.DeuringG8Alg

/-!
# A3-ord, G8: `End_π(A) ⊗ ℚ = ℚ(π)` (the `End` case of Tate, no `ℓ`-adics)

`docs/ARITH_DEURING_G8.md` §2. Let `A` be a one-dimensional abelian variety over an
algebraically closed field and `π ∈ End(A)` with `π² − tπ + q = 0`, `t² < 4q`. Then **every
endomorphism `e` commuting with `π` has a nonzero multiple in `ℤ + ℤπ`**
(`exists_zpow_eq_of_comm`), so `End_π(A)` has rank `≤ 2` (`finrank_endPi_le_two`).

Proof, in the endomorphism ring (Stacks' `postcompSubring`, composition reversed): put
`x = 2π − t`, `y = 2e − s` (`s = Tr e`), so `x² = t² − 4q < 0` and `y² = s² − 4 deg e ≤ 0`
(Cayley–Hamilton, `DeuringG3`, and Hasse, `DeuringG4`). The endomorphism `z = xy` satisfies its
own Cayley–Hamilton relation `z² − τz + deg z = 0` with `z² = x²y² ≥ 0`. If `τ ≠ 0` this
makes `z` and then `y` a rational multiple of `x`; if `τ = 0` then `deg z = 0`, so `z = 0` and
`y = 0`. The algebra is `G8.exists_mul_eq_of_sq` in the commutative subring generated by `π`
and `e`; torsion-freeness and the degree are those of `End(A)`.
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory Polynomial
open scoped CategoryTheory.MonObj IsMulCommutative

universe u

namespace RamanujanWeil.Arith.Deuring.G8

open RamanujanWeil.Arith.Deuring.Geom Stacks.Groupoids RamanujanWeil.Arith.Deuring.Dual2

section Ring

variable {k : Type u} [Field k] {A : Over (Spec (.of k))} [GrpObj A] [IsCommMonObj A]

theorem eq_zero_of_postcompHom_eq_one (E : postcompSubring A) (h : postcompHom E = 1) :
    E = 0 := by
  apply Subtype.ext
  refine DFunLike.ext _ _ fun y => ?_
  apply Additive.toMul.injective
  have h1 := postcompHom_apply E (Additive.toMul y)
  rw [ofMul_toMul, h, MonObj.comp_one] at h1
  rw [h1]
  rfl

theorem postcompOf_postcompHom (E : postcompSubring A) [IsMonHom (postcompHom E)] :
    postcompOf (postcompHom E) = E := by
  apply Subtype.ext
  refine DFunLike.ext _ _ fun y => ?_
  apply Additive.toMul.injective
  have h1 := postcompHom_apply E (Additive.toMul y)
  rw [ofMul_toMul] at h1
  rw [h1]
  rfl

theorem postcompOf_comp (x y : A ⟶ A) [IsMonHom x] [IsMonHom y] :
    postcompOf (x ≫ y) = postcompOf y * postcompOf x := by
  apply Subtype.ext
  refine DFunLike.ext _ _ fun z => ?_
  apply Additive.toMul.injective
  show Additive.toMul z ≫ x ≫ y = (Additive.toMul z ≫ x) ≫ y
  rw [Category.assoc]

variable (A) in
/-- The elements of `postcompSubring A` which are (postcomposition with) homomorphisms. -/
def homSub : Subring (postcompSubring A) where
  carrier := {E | IsMonHom (postcompHom E)}
  mul_mem' {E F} hE hF := by
    have : IsMonHom (postcompHom E) := hE
    have : IsMonHom (postcompHom F) := hF
    show IsMonHom (postcompHom (E * F))
    rw [postcompHom_mul]
    infer_instance
  one_mem' := by
    show IsMonHom (postcompHom (1 : postcompSubring A))
    rw [postcompHom_one]
    infer_instance
  add_mem' {E F} hE hF := by
    have : IsMonHom (postcompHom E) := hE
    have : IsMonHom (postcompHom F) := hF
    show IsMonHom (postcompHom (E + F))
    rw [postcompHom_add]
    exact isMonHom_mul _ _
  zero_mem' := by
    show IsMonHom (postcompHom (0 : postcompSubring A))
    change IsMonHom (1 : A ⟶ A)
    infer_instance
  neg_mem' {E} hE := by
    have : IsMonHom (postcompHom E) := hE
    show IsMonHom (postcompHom (-E))
    rw [← neg_one_zsmul, postcompHom_zsmul]
    exact isMonHom_zpow_of_isCommMonObj _ _

theorem postcompOf_mem_homSub (x : A ⟶ A) [IsMonHom x] : postcompOf x ∈ homSub A := by
  show IsMonHom (postcompHom (postcompOf x))
  rw [postcompHom_postcompOf]
  infer_instance

end Ring

section AV

variable {k : Type u} [Field k] [IsAlgClosed k] {A : Over (Spec (.of k))} [GrpObj A]
  [AlgebraicGeometry.IsAbelianVariety k A]

/-- The trace of an endomorphism of a one-dimensional abelian variety is an integer. -/
theorem exists_int_trace (hA : abelianVarietyDimension A = 1) (x : A ⟶ A) [IsMonHom x] :
    ∃ τ : ℤ, abelianVarietyTrace A x = τ := by
  have h := endDegree_zpow_mul_zpow hA x 1 1
  set d1 := endDegree A (x ^ (1 : ℤ) * (𝟙 A) ^ (1 : ℤ))
  refine ⟨(d1 : ℤ) - endDegree A x - 1, ?_⟩
  push_cast
  simp only [Int.cast_one, one_pow, one_mul] at h
  linarith

variable [IsCommMonObj A]

/-- **Cayley–Hamilton in `postcompSubring A`**: `x² − τx + deg x = 0`. -/
theorem postcompOf_sq (hA : abelianVarietyDimension A = 1) (x : A ⟶ A) [IsMonHom x] (τ : ℤ)
    (hτ : abelianVarietyTrace A x = τ) :
    postcompOf x * postcompOf x - (τ : postcompSubring A) * postcompOf x +
      ((endDegree A x : ℤ) : postcompSubring A) = 0 := by
  have hχ : endCharPoly A x =
      (Polynomial.X ^ 2 - C τ * Polynomial.X + C (endDegree A x : ℤ) : ℤ[X]).map (Int.castRingHom ℚ) := by
    rw [endCharPoly_eq_of_dim_one hA x, hτ]
    simp
  have h1 := endPolyEval_eq_one_of_endCharPoly_eq hA x _ hχ
  have h2 := eq_zero_of_postcompHom_eq_one _ h1
  have h3 : aeval (postcompOf x) (Polynomial.X ^ 2 - C τ * Polynomial.X + C (endDegree A x : ℤ) : ℤ[X]) =
      postcompOf x * postcompOf x - (τ : postcompSubring A) * postcompOf x +
        ((endDegree A x : ℤ) : postcompSubring A) := by
    simp only [map_add, map_sub, map_mul, map_pow, aeval_X, aeval_C, algebraMap_int_eq,
      eq_intCast, map_intCast, map_natCast, Int.cast_natCast, sq]
  rw [← h3]
  exact h2

/-- `(n : End) * w = 0 ⇒ w = 0` for a homomorphism `w`, `n ≠ 0`. -/
theorem eq_zero_of_intCast_mul (hA : abelianVarietyDimension A = 1) (n : ℤ) (hn : n ≠ 0)
    (w : postcompSubring A) [IsMonHom (postcompHom w)]
    (h : (n : postcompSubring A) * w = 0) : w = 0 := by
  have h1 : postcompHom ((n : postcompSubring A) * w) = (postcompHom w) ^ n := by
    rw [postcompHom_mul, postcompHom_intCast, comp_zpow_id]
  rw [h] at h1
  have h0 : postcompHom (0 : postcompSubring A) = 1 := rfl
  rw [h0] at h1
  exact eq_zero_of_postcompHom_eq_one w (eq_one_of_zpow_eq_one hA (postcompHom w) n hn h1.symm)

end AV

section Main

variable {k : Type u} [Field k] [IsAlgClosed k] {A : Over (Spec (.of k))} [GrpObj A]
  [AlgebraicGeometry.IsAbelianVariety k A]

set_option maxHeartbeats 1000000 in
/-- **`End_π(A) ⊗ ℚ = ℚ(π)`**: an endomorphism commuting with `π` (`π² − tπ + q = 0`,
`t² < 4q`) has a nonzero multiple in `ℤ + ℤπ`. -/
theorem exists_zpow_eq_of_comm (hA : abelianVarietyDimension A = 1) (π e : A ⟶ A)
    [IsMonHom π] [IsMonHom e] (t q : ℤ)
    (hπ : endPolyEval π (Polynomial.X ^ 2 - C t * Polynomial.X + C q) = 1) (hdisc : t ^ 2 < 4 * q)
    (hcomm : e ≫ π = π ≫ e) :
    ∃ N a b : ℤ, N ≠ 0 ∧ e ^ N = π ^ b * (𝟙 A) ^ a := by
  obtain ⟨P, hP⟩ : ∃ P : postcompSubring A, P = postcompOf π := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : postcompSubring A, E = postcompOf e := ⟨_, rfl⟩
  have hPE : P * E = E * P := by
    rw [hP, hE, ← postcompOf_comp e π, ← postcompOf_comp π e]
    simp only [hcomm]
  -- Cayley–Hamilton for `π` and `e`
  have hP2 : P * P - (t : postcompSubring A) * P + (q : postcompSubring A) = 0 := by
    have h2 := eq_zero_of_postcompHom_eq_one _ hπ
    have h3 : aeval (postcompOf π) (Polynomial.X ^ 2 - C t * Polynomial.X + C q : ℤ[X]) =
        P * P - (t : postcompSubring A) * P + (q : postcompSubring A) := by
      rw [hP]
      simp only [map_add, map_sub, map_mul, map_pow, aeval_X, aeval_C, algebraMap_int_eq,
        eq_intCast, map_intCast, map_natCast, Int.cast_natCast, sq]
    rw [← h3]
    exact h2
  obtain ⟨s, hs⟩ := exists_int_trace hA e
  set d : ℤ := (endDegree A e : ℤ) with hd
  have hE2 : E * E - (s : postcompSubring A) * E + (d : postcompSubring A) = 0 := by
    rw [hE]; exact postcompOf_sq hA e s hs
  have hHasse : s ^ 2 ≤ 4 * d := by
    have h := trace_sq_le_four_mul_endDegree hA e
    rw [hs] at h
    rw [hd]
    exact_mod_cast h
  -- the commutative subring generated by `π` and `e`
  obtain ⟨T, hTdef⟩ : ∃ T : Subring (postcompSubring A), T = Subring.closure ({P, E} : Set (postcompSubring A)) := ⟨_, rfl⟩
  have hcomm' : ∀ a ∈ ({P, E} : Set (postcompSubring A)), ∀ b ∈ ({P, E} : Set (postcompSubring A)), a * b = b * a := by
    intro a ha b hb
    rcases ha with rfl | ha <;> rcases hb with rfl | hb
    · rfl
    · rw [Set.mem_singleton_iff.mp hb]; exact hPE
    · rw [Set.mem_singleton_iff.mp ha]; exact hPE.symm
    · rw [Set.mem_singleton_iff.mp ha, Set.mem_singleton_iff.mp hb]
  haveI : IsMulCommutative T := by rw [hTdef]; exact Subring.isMulCommutative_closure hcomm'
  have hTH : T ≤ homSub A := by
    rw [hTdef, Subring.closure_le]
    rintro a (rfl | ha)
    · rw [hP]; exact postcompOf_mem_homSub π
    · rw [Set.mem_singleton_iff.mp ha, hE]; exact postcompOf_mem_homSub e
  let P' : T := ⟨P, by rw [hTdef]; exact Subring.subset_closure (by simp)⟩
  let E' : T := ⟨E, by rw [hTdef]; exact Subring.subset_closure (by simp)⟩
  have hP2' : P' * P' - (t : T) * P' + (q : T) = 0 := Subtype.ext (by
    simp only [Subring.coe_add, AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_intCast,
      Subring.coe_zero]
    exact hP2)
  have hE2' : E' * E' - (s : T) * E' + (d : T) = 0 := Subtype.ext (by
    simp only [Subring.coe_add, AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_intCast,
      Subring.coe_zero]
    exact hE2)
  -- torsion-freeness of `T`
  have htf : ∀ (n : ℤ) (w : T), n ≠ 0 → (n : T) * w = 0 → w = 0 := by
    intro n w hn hw
    have hwH : (w : postcompSubring A) ∈ homSub A := hTH w.2
    have : IsMonHom (postcompHom (w : postcompSubring A)) := hwH
    have hw' : (n : postcompSubring A) * (w : postcompSubring A) = 0 := by
      have := congrArg Subtype.val hw
      simp only [Subring.coe_mul, Subring.coe_intCast, Subring.coe_zero] at this
      exact this
    exact Subtype.ext (eq_zero_of_intCast_mul hA n hn (w : postcompSubring A) hw')
  -- `x = 2π − t`, `y = 2e − s`, `z = xy`
  set x : T := 2 * P' - (t : T) with hx
  set y : T := 2 * E' - (s : T) with hy
  have hxx : x * x = ((t ^ 2 - 4 * q : ℤ) : T) := by
    rw [hx]; push_cast; linear_combination 4 * hP2'
  have hyy : y * y = ((s ^ 2 - 4 * d : ℤ) : T) := by
    rw [hy]; push_cast; linear_combination 4 * hE2'
  -- Cayley–Hamilton for `z`
  set zS : postcompSubring A := ((x * y : T) : postcompSubring A) with hzS
  have hzH : zS ∈ homSub A := hTH (x * y).2
  have : IsMonHom (postcompHom zS) := hzH
  obtain ⟨τ, hτ⟩ := exists_int_trace hA (postcompHom zS)
  have hz2 := postcompOf_sq hA (postcompHom zS) τ hτ
  rw [postcompOf_postcompHom] at hz2
  set δ : ℤ := (endDegree A (postcompHom zS) : ℤ) with hδ
  have hz2' : (x * y) * (x * y) - (τ : T) * (x * y) + (δ : T) = 0 := Subtype.ext (by
    simp only [Subring.coe_add, AddSubgroupClass.coe_sub, Subring.coe_mul, Subring.coe_intCast,
      Subring.coe_zero]
    rw [hzS] at hz2
    exact hz2)
  have hδ0 : δ = 0 → x * y = 0 := by
    intro h0
    have h1 : endDegree A (postcompHom zS) = 0 := by rw [hδ] at h0; exact_mod_cast h0
    rw [endDegree_eq_zero_iff hA] at h1
    exact Subtype.ext (eq_zero_of_postcompHom_eq_one zS h1)
  obtain ⟨N, c, hN, hNc⟩ := exists_mul_eq_of_sq htf x y (t ^ 2 - 4 * q) (s ^ 2 - 4 * d) τ δ
    (by linarith) (by linarith) hxx hyy hz2' (by positivity) hδ0
  -- back to homomorphisms: `2N e = 2c π + (N s − c t)`
  have hrel : ((2 * N : ℤ) : T) * E' = ((2 * c : ℤ) : T) * P' + ((N * s - c * t : ℤ) : T) := by
    push_cast
    rw [hx, hy] at hNc
    linear_combination hNc
  have hrelS : ((2 * N : ℤ) : postcompSubring A) * E =
      ((2 * c : ℤ) : postcompSubring A) * P + ((N * s - c * t : ℤ) : postcompSubring A) := by
    have := congrArg Subtype.val hrel
    simp only [Subring.coe_add, Subring.coe_mul, Subring.coe_intCast] at this
    exact this
  have hpost := congrArg postcompHom hrelS
  rw [postcompHom_add, postcompHom_mul, postcompHom_mul, postcompHom_intCast, postcompHom_intCast,
    postcompHom_intCast, hE, hP, postcompHom_postcompOf, postcompHom_postcompOf, comp_zpow_id,
    comp_zpow_id] at hpost
  exact ⟨2 * N, N * s - c * t, 2 * c, mul_ne_zero two_ne_zero hN, hpost⟩

end Main

end RamanujanWeil.Arith.Deuring.G8
