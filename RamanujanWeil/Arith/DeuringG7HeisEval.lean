import RamanujanWeil.Arith.DeuringG7DGapsBridge

/-!
# A3-ord, G7 Heisenberg (evaluation): values of `τ_P f` at affine points

`docs/ARITH_DEURING_G7_AJHEIS.md` §2. Let `W / F` be elliptic, `R = F[E]`, `K = F(E)`, and
`P = −Q = (x₀, y₁)` an affine point. For an affine point `Z = (a, b)` with `a ≠ x₀` and every
`r ∈ R`, the function `τ_P r` is regular at `Z` with value `r(Z + P)`.

"Regular at `Z` with value `c`" is **`HasVal Z u c`**: `(x − x₀)^k u = s ∈ R` with
`s(Z) = (a − x₀)^k c`. It is closed under the ring operations, and `(x − x₀)⁻¹` has value
`(a − x₀)⁻¹`. The formulas of `transX_neg` / `transY_neg` (Mathlib's chord law for `ξ + P`)
evaluate to Mathlib's chord law for `Z + P`; an induction over generators gives the claim for all
of `R` (**`hasVal_trans`**).

* `evPt Z`: evaluation `R → F` at an affine point (`coordHom`).
* `adjoin_xR_yR`: `F[E]` is generated by `x, y`.
* **`hasVal_trans`**, and the consequence **`eval_eq_zero_of_eigen`**: if `f · τ_P v = λ v`
  with `f ∈ R`, `λ ≠ 0` and `v(Z + P) = 0`, then `v(Z) = 0`.
-/

noncomputable section

namespace RamanujanWeil.Arith.Deuring.Geom.G7.DGeom

open WeierstrassCurve WeierstrassCurve.Affine Polynomial
open scoped nonZeroDivisors Polynomial.Bivariate

universe u

set_option linter.unusedSectionVars false

open scoped Classical

variable {F : Type u} [Field F] (W : Affine F) [W.IsElliptic] [DecidableEq F]

local notation "cK" => algebraMap F (Kf W)
local notation "ιK" => algebraMap (Rg W) (Kf W)

/-! ### Evaluation at affine points -/

/-- Evaluation `R → F` at an affine point `Z ≠ O`. -/
def evPt (Z : (W⁄F).Point) (hZ : Z ≠ 0) : Rg W →ₐ[F] F :=
  coordHom W (ptX W Z) (ptY W Z) (nonsingular_pt W hZ).1

theorem evPt_xR (Z : (W⁄F).Point) (hZ : Z ≠ 0) : evPt W Z hZ (xR W) = ptX W Z :=
  coordHom_xR W _ _ _

theorem evPt_yR (Z : (W⁄F).Point) (hZ : Z ≠ 0) : evPt W Z hZ (yR W) = ptY W Z :=
  coordHom_yR W _ _ _

theorem evPt_congr {Z Z' : (W⁄F).Point} (e : Z = Z') (hZ : Z ≠ 0) (hZ' : Z' ≠ 0) (r : Rg W) :
    evPt W Z hZ r = evPt W Z' hZ' r := by
  subst e; rfl

theorem ιK_algebraMap (c : F) : ιK (algebraMap F (Rg W) c) = cK c :=
  (IsScalarTower.algebraMap_apply F (Rg W) (Kf W) c).symm

theorem ιK_injective : Function.Injective ιK := IsFractionRing.injective (Rg W) (Kf W)

/-! ### `F[E]` is generated by `x, y` -/

theorem of_mem_adjoin (p : F[X]) :
    AdjoinRoot.of (W⁄F).polynomial p ∈ Algebra.adjoin F ({xR W, yR W} : Set (Rg W)) := by
  induction p using Polynomial.induction_on with
  | C c =>
    have : AdjoinRoot.of (W⁄F).polynomial (C c) = algebraMap F (Rg W) c := rfl
    rw [this]
    exact Subalgebra.algebraMap_mem _ c
  | add p q hp hq => rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | monomial n c ih =>
    rw [pow_succ, ← mul_assoc, map_mul]
    exact Subalgebra.mul_mem _ ih (Algebra.subset_adjoin (Set.mem_insert _ _))

theorem adjoin_xR_yR : Algebra.adjoin F ({xR W, yR W} : Set (Rg W)) = ⊤ := by
  refine eq_top_iff.2 fun r _ => ?_
  obtain ⟨p, q, rfl⟩ := CoordinateRing.exists_smul_basis_eq r
  have hY : CoordinateRing.mk (W⁄F) Y = yR W := AdjoinRoot.mk_X
  rw [hY, Algebra.smul_def, Algebra.smul_def, mul_one, AdjoinRoot.algebraMap_eq]
  exact Subalgebra.add_mem _ (of_mem_adjoin W p)
    (Subalgebra.mul_mem _ (of_mem_adjoin W q)
      (Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))))

/-- Induction over generators of `F[E]`. -/
theorem rg_induction (S : Subalgebra F (Rg W)) (hx : xR W ∈ S) (hy : yR W ∈ S) (r : Rg W) :
    r ∈ S := by
  have : Algebra.adjoin F ({xR W, yR W} : Set (Rg W)) ≤ S := by
    rw [Algebra.adjoin_le_iff]
    rintro z (rfl | rfl)
    · exact hx
    · exact hy
  exact this (adjoin_xR_yR W ▸ Algebra.mem_top)

/-! ### Regularity and value at an affine point -/

variable (x₀ : F)

/-- `x − x₀ ∈ R`. -/
abbrev dR : Rg W := xR W - algebraMap F (Rg W) x₀

theorem ιK_dR : ιK (dR W x₀) = genX W - cK x₀ := by
  rw [map_sub, ιK_algebraMap]; rfl

theorem ιK_dR_ne_zero : ιK (dR W x₀) ≠ 0 := by
  rw [ιK_dR]; exact genX_sub_ne_zero W

/-- **`u ∈ K` is regular at the affine point `Z` (with `x(Z) ≠ x₀`) with value `c`**:
`(x − x₀)^k u = s ∈ R` and `s(Z) = (x(Z) − x₀)^k c`. -/
def HasVal (Z : (W⁄F).Point) (hZ : Z ≠ 0) (u : Kf W) (c : F) : Prop :=
  ∃ (k : ℕ) (s : Rg W), ιK s = ιK (dR W x₀) ^ k * u ∧
    evPt W Z hZ s = (ptX W Z - x₀) ^ k * c

variable {W x₀} {Z : (W⁄F).Point} {hZ : Z ≠ 0}

theorem evPt_dR : evPt W Z hZ (dR W x₀) = ptX W Z - x₀ := by
  rw [map_sub, AlgHom.commutes, evPt_xR]; rfl

theorem hasVal_alg (r : Rg W) : HasVal W x₀ Z hZ (ιK r) (evPt W Z hZ r) :=
  ⟨0, r, by rw [pow_zero, one_mul], by rw [pow_zero, one_mul]⟩

theorem hasVal_const (c : F) : HasVal W x₀ Z hZ (cK c) c := by
  have := hasVal_alg (W := W) (x₀ := x₀) (hZ := hZ) (algebraMap F (Rg W) c)
  rwa [ιK_algebraMap, AlgHom.commutes] at this

theorem hasVal_add {u v : Kf W} {c e : F} (hu : HasVal W x₀ Z hZ u c)
    (hv : HasVal W x₀ Z hZ v e) : HasVal W x₀ Z hZ (u + v) (c + e) := by
  obtain ⟨k, s, hs, hes⟩ := hu
  obtain ⟨l, t, ht, het⟩ := hv
  refine ⟨k + l, s * dR W x₀ ^ l + t * dR W x₀ ^ k, ?_, ?_⟩
  · rw [map_add, map_mul, map_mul, map_pow, map_pow, hs, ht]; ring
  · rw [map_add, map_mul, map_mul, map_pow, map_pow, hes, het, evPt_dR]; ring

theorem hasVal_mul {u v : Kf W} {c e : F} (hu : HasVal W x₀ Z hZ u c)
    (hv : HasVal W x₀ Z hZ v e) : HasVal W x₀ Z hZ (u * v) (c * e) := by
  obtain ⟨k, s, hs, hes⟩ := hu
  obtain ⟨l, t, ht, het⟩ := hv
  refine ⟨k + l, s * t, ?_, ?_⟩
  · rw [map_mul, hs, ht]; ring
  · rw [map_mul, hes, het]; ring

theorem hasVal_neg {u : Kf W} {c : F} (hu : HasVal W x₀ Z hZ u c) :
    HasVal W x₀ Z hZ (-u) (-c) := by
  have := hasVal_mul (hasVal_const (W := W) (x₀ := x₀) (hZ := hZ) (-1)) hu
  rwa [map_neg, map_one, neg_one_mul, neg_one_mul] at this

theorem hasVal_sub {u v : Kf W} {c e : F} (hu : HasVal W x₀ Z hZ u c)
    (hv : HasVal W x₀ Z hZ v e) : HasVal W x₀ Z hZ (u - v) (c - e) := by
  rw [sub_eq_add_neg, sub_eq_add_neg]; exact hasVal_add hu (hasVal_neg hv)

theorem hasVal_pow {u : Kf W} {c : F} (hu : HasVal W x₀ Z hZ u c) (n : ℕ) :
    HasVal W x₀ Z hZ (u ^ n) (c ^ n) := by
  induction n with
  | zero => rw [pow_zero, pow_zero, ← map_one cK]; exact hasVal_const 1
  | succ n ih => rw [pow_succ, pow_succ]; exact hasVal_mul ih hu

theorem hasVal_inv_d (hx : ptX W Z ≠ x₀) :
    HasVal W x₀ Z hZ (ιK (dR W x₀))⁻¹ (ptX W Z - x₀)⁻¹ :=
  ⟨1, 1, by rw [map_one, pow_one, mul_inv_cancel₀ (ιK_dR_ne_zero W x₀)], by
    rw [map_one, pow_one, mul_inv_cancel₀ (sub_ne_zero.2 hx)]⟩

theorem hasVal_div_d (hx : ptX W Z ≠ x₀) {u : Kf W} {c : F} (hu : HasVal W x₀ Z hZ u c) :
    HasVal W x₀ Z hZ (u / ιK (dR W x₀)) (c / (ptX W Z - x₀)) := by
  rw [div_eq_mul_inv, div_eq_mul_inv]; exact hasVal_mul hu (hasVal_inv_d hx)

theorem hasVal_genX : HasVal W x₀ Z hZ (genX W) (ptX W Z) := by
  have := hasVal_alg (W := W) (x₀ := x₀) (hZ := hZ) (xR W)
  rwa [evPt_xR] at this

theorem hasVal_genY : HasVal W x₀ Z hZ (genY W) (ptY W Z) := by
  have := hasVal_alg (W := W) (x₀ := x₀) (hZ := hZ) (yR W)
  rwa [evPt_yR] at this


/-! ### The value of `τ_P r` at `Z` -/

section Trans

variable (W) {y₀ : F} (h : (W⁄F).Nonsingular x₀ y₀)

/-- The slope at `Z` of the line through `Z` and `P = (x₀, y₁)`. -/
abbrev slopeZ (Z : (W⁄F).Point) : F := (ptY W Z - yN W (x₀ := x₀) (y₀ := y₀)) / (ptX W Z - x₀)

include h in
theorem add_neg_spec (hZ : Z ≠ 0) (hx : ptX W Z ≠ x₀) :
    ∃ _ : Z + -(Point.some x₀ y₀ h) ≠ 0,
      ptX W (Z + -(Point.some x₀ y₀ h)) = (W⁄F).addX (ptX W Z) x₀ (slopeZ W (x₀ := x₀) (y₀ := y₀) Z) ∧
      ptY W (Z + -(Point.some x₀ y₀ h)) =
        (W⁄F).addY (ptX W Z) x₀ (ptY W Z) (slopeZ W (x₀ := x₀) (y₀ := y₀) Z) := by
  cases Z with
  | zero => exact absurd rfl hZ
  | some a b hab =>
    change a ≠ x₀ at hx
    rw [Point.neg_some, Point.add_of_X_ne hx]
    refine ⟨Point.some_ne_zero _, ?_, ?_⟩
    · change (W⁄F).addX a x₀ ((W⁄F).slope a x₀ b _) = _
      rw [slope_of_X_ne hx]; rfl
    · change (W⁄F).addY a x₀ b ((W⁄F).slope a x₀ b _) = _
      rw [slope_of_X_ne hx]; rfl

variable {W}

theorem hasVal_lam (hx : ptX W Z ≠ x₀) :
    HasVal W x₀ Z hZ (lam W (x₀ := x₀) (y₀ := y₀)) (slopeZ W (x₀ := x₀) (y₀ := y₀) Z) := by
  rw [lam, ← ιK_dR]
  exact hasVal_div_d hx (hasVal_sub hasVal_genY (hasVal_const _))

include h in
theorem hasVal_transX (hx : ptX W Z ≠ x₀) :
    HasVal W x₀ Z hZ (transX W (-(Point.some x₀ y₀ h)))
      ((W⁄F).addX (ptX W Z) x₀ (slopeZ W (x₀ := x₀) (y₀ := y₀) Z)) := by
  rw [transX_neg W h]
  have hl := hasVal_lam (hZ := hZ) (y₀ := y₀) hx
  exact hasVal_sub (hasVal_sub (hasVal_sub (hasVal_add (hasVal_pow hl 2)
    (hasVal_mul (hasVal_const _) hl)) (hasVal_const _)) hasVal_genX) (hasVal_const _)

include h in
theorem hasVal_transY (hx : ptX W Z ≠ x₀) :
    HasVal W x₀ Z hZ (transY W (-(Point.some x₀ y₀ h)))
      ((W⁄F).addY (ptX W Z) x₀ (ptY W Z) (slopeZ W (x₀ := x₀) (y₀ := y₀) Z)) := by
  rw [transY_neg W h]
  have hl := hasVal_lam (hZ := hZ) (y₀ := y₀) hx
  have hX := hasVal_transX h (hZ := hZ) hx
  exact hasVal_sub (hasVal_sub (hasVal_neg (hasVal_add (hasVal_mul hl (hasVal_sub hX hasVal_genX))
    hasVal_genY)) (hasVal_mul (hasVal_const _) hX)) (hasVal_const _)

include h in
/-- **`τ_P r` is regular at `Z` with value `r(Z + P)`** (`P = −Q`, `x(Z) ≠ x₀`). -/
theorem hasVal_trans (hx : ptX W Z ≠ x₀) (hZP : Z + -(Point.some x₀ y₀ h) ≠ 0) (r : Rg W) :
    HasVal W x₀ Z hZ (trans W (-(Point.some x₀ y₀ h)) (ιK r))
      (evPt W (Z + -(Point.some x₀ y₀ h)) hZP r) := by
  obtain ⟨-, hpx, hpy⟩ := add_neg_spec W h hZ hx
  let S : Subalgebra F (Rg W) :=
    { carrier := {r | HasVal W x₀ Z hZ (trans W (-(Point.some x₀ y₀ h)) (ιK r))
        (evPt W (Z + -(Point.some x₀ y₀ h)) hZP r)}
      mul_mem' := by
        intro a b ha hb
        change HasVal _ _ _ _ _ _
        rw [map_mul, map_mul, map_mul]
        exact hasVal_mul ha hb
      add_mem' := by
        intro a b ha hb
        change HasVal _ _ _ _ _ _
        rw [map_add, map_add, map_add]
        exact hasVal_add ha hb
      algebraMap_mem' := by
        intro c
        change HasVal _ _ _ _ _ _
        rw [ιK_algebraMap, AlgHom.commutes, AlgHom.commutes]
        exact hasVal_const c }
  refine rg_induction W S ?_ ?_ r
  · change HasVal _ _ _ _ _ _
    rw [show ιK (xR W) = genX W from rfl, trans_genX, evPt_xR, hpx]
    exact hasVal_transX h hx
  · change HasVal _ _ _ _ _ _
    rw [show ιK (yR W) = genY W from rfl, trans_genY, evPt_yR, hpy]
    exact hasVal_transY h hx

include h in
/-- **Zeros propagate backwards along an eigenvector.** If `f · τ_P v = μ v` with `f ∈ R`,
`μ ≠ 0`, `x(Z) ≠ x₀`, and `v(Z + P) = 0`, then `v(Z) = 0`. -/
theorem eval_eq_zero_of_eigen (hx : ptX W Z ≠ x₀) (hZP : Z + -(Point.some x₀ y₀ h) ≠ 0)
    {f v : Rg W} {μ : F} (hμ : μ ≠ 0)
    (heig : ιK f * trans W (-(Point.some x₀ y₀ h)) (ιK v) = cK μ * ιK v)
    (hzero : evPt W (Z + -(Point.some x₀ y₀ h)) hZP v = 0) : evPt W Z hZ v = 0 := by
  obtain ⟨k, s, hs, hes⟩ := hasVal_trans h (hZ := hZ) hx hZP v
  rw [hzero, mul_zero] at hes
  have key : f * s = dR W x₀ ^ k * (algebraMap F (Rg W) μ * v) := by
    apply ιK_injective W
    rw [map_mul, hs, map_mul, map_mul, map_pow, ιK_algebraMap, ← heig]
    ring
  have := congrArg (evPt W Z hZ) key
  rw [map_mul, hes, mul_zero, map_mul, map_mul, map_pow, evPt_dR, AlgHom.commutes] at this
  have hd : (ptX W Z - x₀) ^ k ≠ 0 := pow_ne_zero _ (sub_ne_zero.2 hx)
  rcases mul_eq_zero.1 this.symm with h1 | h1
  · exact absurd h1 hd
  · rcases mul_eq_zero.1 h1 with h2 | h2
    · exact absurd h2 hμ
    · exact h2

end Trans

end RamanujanWeil.Arith.Deuring.Geom.G7.DGeom
